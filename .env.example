DATABASE_URL=postgresql+asyncpg://videomasys:videomasys@localhost:5432/videomasys
ARTIFACT_ROOT=./artifacts
AUTO_CREATE_SCHEMA=true
MAX_UPLOAD_BYTES=21474836480

# Qwen3-VL served by vLLM's OpenAI-compatible server.
VLM_BASE_URL=http://localhost:8001/v1
VLM_API_KEY=local
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
VLM_MAX_CONCURRENCY=4
VLM_ENABLE_THINKING=false

# Run Qwen3-Embedding on a second lightweight endpoint.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://localhost:8002/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024

SCENE_THRESHOLD=0.32
MIN_SCENE_SECONDS=2.0
MAX_SCENE_SECONDS=20.0
MAX_SCENES_PER_VIDEO=300
MAX_SCENES_PER_EVENT=8
MAX_EVENT_SECONDS=120
FRAMES_PER_SCENE=3
MEDIA_MAX_CONCURRENCY=4
QA_RETRIEVAL_LIMIT=6
QA_FRAMES_PER_INTERVAL=8
QA_USE_VIDEO_CLIP=true
QA_CLIP_FPS=4.0
WORKER_POLL_SECONDS=1.0
